{
  "manifest_version": 3,
  "name": "Duckit",
  "version": "1.0.0",
  "description": "Markierten Text oder URLs sofort in Duckit speichern. 🦆",
  "permissions": ["contextMenus", "storage", "activeTab", "notifications"],
  "host_permissions": [
    "https://jqudjvbvwqrglulbrycq.supabase.co/*",
    "https://clipnote-nu.vercel.app/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "ClipNote"
  },
  "content_scripts": [
    {
      "matches": ["https://clipnote-nu.vercel.app/*"],
      "js": ["content.js"],
      "run_at": "document_end"
    }
  ],
  "icons": {
    "16":  "icons/icon16.png",
    "48":  "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
